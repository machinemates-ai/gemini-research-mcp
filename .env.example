# Required: Google AI Studio API key
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: Shared model for research_web and research_followup (default: gemini-4-argon)
# Argon requires paid-tier API access. Explicitly opt back to the former Flash model:
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Model for session metadata, titles, and semantic session matching
# GEMINI_SUMMARY_MODEL=gemini-3.8-flash

# Query clarification uses fixed gemini-3.8-flash, independently of these overrides.

# Optional: Override the Deep Research agent
# DEEP_RESEARCH_AGENT=deep-research-preview-04-2026

# Optional: Vertex AI project settings

# --- Storage (sessions and export artifacts) ---

# Local default: sessions/exports use DiskStore and Tasks use memory. No Redis
# installation or process is required.
#
# Optional for multi-worker deployments: one Redis/Valkey-compatible URL shares
# sessions, exports, and Tasks. Requires the `distributed` extra.
# GEMINI_RESEARCH_STORAGE_URL=redis://localhost:6379/0

# Optional advanced override: use a different Docket backend for Tasks.
# Explicit FASTMCP_DOCKET_URL takes priority over GEMINI_RESEARCH_STORAGE_URL.
# FASTMCP_DOCKET_URL=redis://localhost:6379/1

# Optional: custom directory for the local DiskStore (default: XDG data dir)
# GEMINI_RESEARCH_STORAGE_PATH=/var/lib/gemini-research-mcp

# Optional: override the default session/export TTL (seconds)
# GEMINI_RESEARCH_TTL_SECONDS=604800

# Optional: disk-first export destination (default: ~/.gemini-research/exports/)
# GEMINI_RESEARCH_EXPORT_DIR=~/.gemini-research/exports

# --- Transport (stdio is the default; streamable-http is opt-in) ---

# Optional: "stdio" (default) or "streamable-http"
# GEMINI_RESEARCH_TRANSPORT=stdio

# Optional: bind host for streamable-http. Anything other than
# 127.0.0.1/localhost/::1 requires GEMINI_RESEARCH_HTTP_BEARER_TOKEN to be set,
# or the server refuses to start.
# GEMINI_RESEARCH_HTTP_HOST=127.0.0.1

# Optional: bind port/path for streamable-http
# GEMINI_RESEARCH_HTTP_PORT=8000
# GEMINI_RESEARCH_HTTP_PATH=/mcp

# Optional: static bearer token required to call streamable-http.
# Generate with: openssl rand -hex 32
# Never reuse GEMINI_API_KEY as this token - it is a provider secret, not an
# MCP client credential.
# GEMINI_RESEARCH_HTTP_BEARER_TOKEN=

# --- Optional Local Deep Research engine (off unless all of these are set) ---
# Bridges an operator-installed Local Deep Research `ldr-mcp` (stdio) with
# Ollama on loopback and an explicit web search. Nothing is installed or started
# for you; the child process is not sandboxed. A local run is blocking, has no
# provider ID and cannot be recovered after a restart.

# Absolute path of the ldr-mcp executable (never resolved through PATH).
# GEMINI_RESEARCH_LDR_COMMAND=/opt/ldr/bin/ldr-mcp

# These are the only LDR_* values forwarded to the child; they are verified
# against LDR's get_configuration before any research query is sent.
# LDR_LLM_PROVIDER=ollama
# LDR_LLM_MODEL=llama3:8b
# LDR_LLM_OLLAMA_URL=http://127.0.0.1:11434
# LDR_SEARCH_TOOL=searxng
# LDR_SEARCH_ENGINE_WEB_SEARXNG_DEFAULT_PARAMS_INSTANCE_URL=http://127.0.0.1:8080

# Optional opt-in to expose the local engine over streamable-http. Stdio only
# by default; HTTP still requires the authenticated owner boundary above.
# GEMINI_RESEARCH_LDR_ALLOW_HTTP=false
